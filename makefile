# Compiler and flags
CXX := g++
CXXFLAGS := -g -pthread -Wall -std=c++17 -MMD -MP

# Directories and files
SRC_DIR := src
OBJ_DIR := obj
TARGET := Elevator.exe

SRCS := $(wildcard $(SRC_DIR)/*.cpp)
OBJS := $(patsubst $(SRC_DIR)/%.cpp,$(OBJ_DIR)/%.o,$(SRCS))

# Tests: every source file except Main.cpp plus the files in tests/
TEST_TARGET := ElevatorTests.exe
TEST_SRCS := $(wildcard tests/*.cpp)
TEST_OBJS := $(patsubst tests/%.cpp,$(OBJ_DIR)/tests_%.o,$(TEST_SRCS))
LIB_OBJS := $(filter-out $(OBJ_DIR)/Main.o,$(OBJS))

.PHONY: all clean test

all: $(TARGET)

test: $(TEST_TARGET)
	./$(TEST_TARGET)

$(TEST_TARGET): $(TEST_OBJS) $(LIB_OBJS)
	@echo "Linking $(TEST_TARGET)..."
	$(CXX) $(CXXFLAGS) $^ -o $@

$(OBJ_DIR)/tests_%.o: tests/%.cpp | $(OBJ_DIR)
	@echo "Compiling $<..."
	$(CXX) $(CXXFLAGS) -Isrc -c $< -o $@

$(TARGET): $(OBJS)
	@echo "Linking $(TARGET)..."
	$(CXX) $(CXXFLAGS) $^ -o $@

$(OBJ_DIR)/%.o: $(SRC_DIR)/%.cpp | $(OBJ_DIR)
	@echo "Compiling $<..."
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(OBJ_DIR):
	mkdir -p $(OBJ_DIR)

# Header dependencies generated by -MMD: a changed header rebuilds the files that include it
-include $(OBJS:.o=.d)

clean:
	@echo "Cleaning up..."
	rm -rf $(OBJ_DIR) $(TARGET) $(TEST_TARGET) tests_config.json
